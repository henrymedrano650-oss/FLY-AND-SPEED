end

-- ========== CLONE ==========
local function spawnClone(targetName)
    local sourceChar = Character
    if targetName and targetName ~= "" then
        local target = nil
        for _, p in pairs(Players:GetPlayers()) do
            if p.Name:lower():find(targetName:lower(), 1, true) then target = p; break end
        end
        if not target then return nil, "notfound" end
        if not target.Character then return nil, "nochar" end
        sourceChar = target.Character
    end
    if not sourceChar then return nil, "nochar" end
    local ok, clone = pcall(function() return sourceChar:Clone() end)
    if not ok or not clone then return nil, "clonefail" end
    clone.Name = LocalPlayer.Name .. "_Clone"
    for _, v in pairs(clone:GetDescendants()) do
        if v:IsA("Script") or v:IsA("LocalScript") or v:IsA("ModuleScript") then v:Destroy() end
    end
    local anim = clone:FindFirstChild("Animate")
    if anim then anim:Destroy() end
    local hum = clone:FindFirstChildOfClass("Humanoid")
    if hum then hum:Destroy() end
    local sr = sourceChar:FindFirstChild("HumanoidRootPart")
    local cp = clone:FindFirstChild("HumanoidRootPart") or clone.PrimaryPart
    if sr and cp then
        clone.PrimaryPart = cp
        pcall(function() clone:SetPrimaryPartCFrame(sr.CFrame * CFrame.new(4,0,0)) end)
    end
    for _, p in pairs(clone:GetDescendants()) do
        if p:IsA("BasePart") then p.Anchored = true p.CanCollide = false end
    end
    clone.Parent = workspace
    table.insert(clones, clone)
    return clone, "ok"
end

local function removeAllClones()
    for _, c in pairs(clones) do if c and c.Parent then c:Destroy() end end
    clones = {}
end

