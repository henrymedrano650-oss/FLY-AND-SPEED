local function addHighlights()
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            if not highlights[p] or not highlights[p].Parent then
                for _, existing in pairs(p.Character:GetChildren()) do
                    if existing:IsA("Highlight") then existing:Destroy() end
                end
                local hl = Instance.new("Highlight")
                hl.FillColor = Color3.fromRGB(255,50,50)
                hl.OutlineColor = Color3.fromRGB(255,255,255)
                hl.FillTransparency = 0.5
                hl.OutlineTransparency = 0
                hl.Adornee = p.Character
                hl.Parent = p.Character
                highlights[p] = hl
            end
        end
    end
end

local function removeHighlights()
    for _, hl in pairs(highlights) do
        if hl and hl.Parent then pcall(function() hl:Destroy() end) end
    end
    highlights = {}
end

-- ========== TROLL - FLING ==========
local function flingPlayer(targetName)
    local target = nil
    for _, p in pairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Name:lower():find(targetName:lower(), 1, true) then
            target = p
            break
        end
    end
    if not target or not target.Character then return false end
    local tRoot = target.Character:FindFirstChild("HumanoidRootPart")
    if not tRoot or not RootPart then return false end

    -- Teleport on top of target
    RootPart.CFrame = tRoot.CFrame * CFrame.new(0,3,0)
    task.wait(0.05)

    -- Apply massive velocity using BodyVelocity on their root
    local fv = Instance.new("BodyVelocity")
    fv.MaxForce = Vector3.new(1e9,1e9,1e9)
    fv.Velocity = Vector3.new(
        math.random(-200,200),
        math.random(300,600),
        math.random(-200,200)
    )
    fv.Parent = tRoot

    -- Also apply to local player for extra force
    local myFV = Instance.new("BodyVelocity")
    myFV.MaxForce = Vector3.new(1e9,1e9,1e9)
    myFV.Velocity = Vector3.new(
        math.random(-100,100),
        math.random(200,400),
        math.random(-100,100)
    )
    myFV.Parent = RootPart

    task.delay(0.2, function()
        pcall(function() if fv.Parent then fv:Destroy() end end)
        pcall(function() if myFV.Parent then myFV:Destroy() end end)
    end)

    return true
end

