local function processAIQuestion(q)
    q = q:lower():gsub("[%p]", "")

    -- Check hard questions first
    for _, hard in pairs(hardQuestions) do
        if q:find(hard) then
            return "🤖 Sorry, I'm in beta and can't answer that question yet. Try asking about Nexo Hub features instead!"
        end
    end

    -- Check knowledge base
    for keyword, answer in pairs(aiKnowledge) do
        if q:find(keyword) then
            return answer
        end
    end

    -- Check for partial matches
    local words = {}
    for word in q:gmatch("%S+") do table.insert(words, word) end

    for keyword, answer in pairs(aiKnowledge) do
        for _, word in pairs(words) do
            if keyword:find(word) and #word > 3 then
                return answer
            end
        end
    end

    -- Unknown
    local unknown = {
        "🤖 Hmm I don't know that one yet. Try asking about fly, noclip, troll, key, teleport or other features!",
        "🤖 I'm still learning! Ask me something like 'how do i fly' or 'what is the key'.",
