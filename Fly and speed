ExtrasTab:CreateSection("⏰ Anti AFK")
ExtrasTab:CreateToggle({
    Name = "Anti AFK",
    CurrentValue = false,
    Flag = "AntiAFK",
    Callback = function(v)
        antiAfkEnabled = v
        if v then
            if antiAfkThread then task.cancel(antiAfkThread) end
            antiAfkThread = task.spawn(function()
                while antiAfkEnabled do
                    task.wait(240)
                    if not antiAfkEnabled then break end
                    pcall(function()
                        if Humanoid then Humanoid.Jump = true task.wait(0.1) Humanoid.Jump = false end
                    end)
                end
            end)
            notify("⏰ Anti AFK ON", "Won't be kicked.")
        else
            if antiAfkThread then task.cancel(antiAfkThread) antiAfkThread = nil end
            notify("⏰ Anti AFK OFF", "Disabled.")
        end
    end,
})

